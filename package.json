{
  "name": "destiny-stone",
  "productName": "Destiny Stone",
  "version": "1.0.0",
  "description": "Cliente Git de escritorio moderno",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node test/git.test.js",
    "smoke": "electron test/smoke.js",
    "dist": "electron-builder",
    "icon": "electron build/make-icon.js"
  },
  "build": {
    "appId": "com.destinystone.app",
    "productName": "Destiny Stone",
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "renderer/**",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "devDependencies": {
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3"
  }
}
